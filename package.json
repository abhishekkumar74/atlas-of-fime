{
  "name": "atlas-of-time-monorepo",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --prefix client",
    "dev:all": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "build": "npm run build --prefix client",
    "test": "npm run test --prefix client",
    "lint": "npm run lint --prefix client",
    "typecheck": "npm run typecheck --prefix client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
